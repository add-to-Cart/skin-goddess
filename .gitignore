# =============================================================
# Skin Goddess — root .gitignore
# =============================================================

# ----- Python / Backend -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Environment / secrets — NEVER commit these
server/.env
.env
*.env
.env.*
# explicitly allow the safe example template
!.env.example
!server/.env.example

# Alembic compiled cache
alembic/__pycache__/

# ----- Node / Frontend -----
client/node_modules/
node_modules/
client/dist/
client/dist-ssr/
dist/
dist-ssr/
*.local

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- OS / Editor -----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

/docs