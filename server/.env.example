# ============================================================
# Skin Goddess — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/clinic_db
# Supabase example (Transaction Pooler, port 6543):
#   DATABASE_URL=postgresql+psycopg2://postgres.xxxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/clinic_db

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on any cloud host.
# The app will refuse to start with weak SECRET_KEY or ADMIN_PASSWORD in prod.
APP_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Single-admin credentials. Change both before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development default (localhost:5173) is used if this is not set.
# Production example:
#   CORS_ORIGINS=https://skin-goddess-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173

# ── Business information (shown on invoices) ──────────────────────────────────
BUSINESS_NAME=Skin Goddess Clinic
BUSINESS_TAGLINE=Beauty & Aesthetic Services
BUSINESS_ADDRESS=Your Clinic Address
BUSINESS_PHONE=+63 XXX XXX XXXX
BUSINESS_EMAIL=clinic@example.com

# ── Invoice email (Mailjet HTTPS API; works on Render Free) ───────────────────
# Create a Mailjet API key/secret and verify the sender address.
EMAIL_PROVIDER=mailjet
MAILJET_API_KEY=7ee76205652ac4182a30405cfe109a88
MAILJET_SECRET_KEY=90e908b745b70863434dddd871b387e4
EMAIL_FROM=jamiaskris@gmail.com
EMAIL_FROM_NAME=Skin Goddess Clinic

# Optional SMTP alternative for hosts that permit outbound SMTP.
# Set EMAIL_PROVIDER=smtp and configure these values instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=clinic@example.com
